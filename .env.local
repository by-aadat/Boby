# ----------------------------------------------------------------------
# KartME environment variables
# Copy this file to .env.local (for local dev) and fill in real values.
# In Vercel, add the same keys under Project Settings > Environment Variables.
# ----------------------------------------------------------------------

# Turns on the real Google Sheets backend. Leave as "false" (or delete it)
# to keep running on mock data with zero setup.
NEXT_PUBLIC_BACKEND_ENABLED=true

# --- Server-side only. NEVER prefix these with NEXT_PUBLIC_. ---
# The Web App URL you get after deploying the Apps Script project.
# Looks like: https://script.google.com/macros/s/AKfycb.../exec
APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbxEuiZ4wVHvFPQAjwMU2PuDY_B7hj8wV_zuJW7SPD6A7vCi413hQdkvCM-j7Q0HnIixEA/exec

# The same random string you set via the spreadsheet's
# "KartME > 3. Set API Secret" menu item.
API_SHARED_SECRET=kartme-9x7Lp2qR8vT4wZ1mN6bY3cF5hJ

# Note: the session-signing secret (used for customer login tokens) is
# auto-generated inside Apps Script the first time it's needed — you
# don't need to set anything extra for it.

# --- Optional: Razorpay online payments ---
# Leave both blank to keep online payment disabled — checkout will show
# a clear message and customers can still pay via COD or UPI-by-hand.
# Get these from your Razorpay dashboard (Settings > API Keys).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Optional: used for sitemap.xml and Open Graph tags ---
NEXT_PUBLIC_SITE_URL=
